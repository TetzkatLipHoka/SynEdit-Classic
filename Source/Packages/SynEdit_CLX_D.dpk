package SynEdit_CLX_D;

{$R *.res}
{$R '..\SynEditReg.dcr'}
{$R '..\SynUniReg.dcr'}
{$R '..\SynSpellCheck.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'SynEdit CLX component suite'}
{$IMPLICITBUILD ON}
{$DEFINE SYN_CLX}
{$LIBSUFFIX 'XE'}

requires
  visualclx,
  visualdbclx,
  designide;

contains
  QSynEditReg in '..\Source\QSynEditReg.pas',
  QSynEditPropertyReg in '..\Source\QSynEditPropertyReg.pas',
  QSynUnicode in '..\Source\QSynUnicode.pas';
//  SynUniReg in '..\SynUniReg.pas',
//  SynSpellReg in '..\SynSpellReg.pas';  

end.

package SynEdit_D7;

{$R *.res}
{$R '..\..\Source\SynEditReg.dcr'}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'SynEdit component suite'}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  {$IFDEF SYN_CLX}
  visualclx,
  visualdbclx, 
  {$ENDIF SYN_CLX}
  {$IFDEF USE_TNT_DESIGNTIME_SUPPORT}
  TntUnicodeVcl_D,
  TntUnicodeVcl_R,  
  {$ENDIF USE_TNT_DESIGNTIME_SUPPORT}
  DesignIDE,
  SynEdit_R7;

contains
  SynEditReg in '..\..\Source\SynEditReg.pas',
  SynEditPropertyReg in '..\..\Source\SynEditPropertyReg.pas',
  {$IFNDEF UNICODE}
  SynUniReg in '..\..\Source\SynUniReg.pas',
  SynSpellReg in '..\..\Source\SynSpellReg.pas',   // depends on SynSpellCheck (not Unicode clean)
  {$ENDIF UNICODE}
  SynHighlighterManager in '..\..\Source\Highlighters\SynHighlighterManager.pas';

end.
